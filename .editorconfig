# EditorConfig — https://editorconfig.org
# Helps all editors and IDEs maintain consistent formatting across contributors.

root = true

# ── Defaults for all files ───────────────────────────────────────────────────
[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = space
indent_size              = 4
trim_trailing_whitespace = true
insert_final_newline     = true

# ── Java source files ────────────────────────────────────────────────────────
[*.java]
indent_style = space
indent_size  = 4

# ── XML (Maven pom.xml, Spring config, etc.) ─────────────────────────────────
[*.xml]
indent_style = space
indent_size  = 4

# ── YAML (Spring Boot application.yml, CI, etc.) ─────────────────────────────
[*.{yml,yaml}]
indent_style = space
indent_size  = 2

# ── Properties files ─────────────────────────────────────────────────────────
[*.properties]
indent_style = space
indent_size  = 4

# ── Web frontend files ───────────────────────────────────────────────────────
[*.{html,css,js,ts,jsx,tsx}]
indent_style = space
indent_size  = 2

# ── JSON (package.json, config files, etc.) ──────────────────────────────────
[*.json]
indent_style = space
indent_size  = 2

# ── Markdown documentation ───────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
indent_style             = space
indent_size              = 2

# ── Shell scripts ────────────────────────────────────────────────────────────
[*.sh]
end_of_line  = lf
indent_style = space
indent_size  = 2

# ── Windows batch / PowerShell ───────────────────────────────────────────────
[*.{bat,cmd,ps1}]
end_of_line = crlf

# ── Makefiles require tabs ───────────────────────────────────────────────────
[Makefile]
indent_style = tab
